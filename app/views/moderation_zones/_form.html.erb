<%# locals: (moderation_zone:) %>

<% content_for :head do %>
  <%= javascript_include_tag "moderation_zone" %>
<% end %>

<%= bootstrap_form_with(:model => moderation_zone) do |form| %>
  <%= form.text_field :name %>

  <%= form.richtext_field :reason, :cols => 80, :rows => 20, :format => moderation_zone.reason_format %>

  <%= form.form_group do %>
    <%= form.label :zone %>
    <div id="map" class="content_map border rounded z-0"></div>
    <%= form.hidden_field :zone %>
  <% end %>

  <%= form.collection_radio_buttons(
        :expiry_type,
        %w[relative absolute],
        :itself,
        ->(type) { t(".#{type}_expiration") },
        :label => t(".expiration"),
        :checked => selected_moderation_zone_expiry_type(moderation_zone)
      ) %>

  <div data-expiry-panel="relative">
    <%= form.select(
          :period,
          options_for_moderation_zone_period,
          :selected => selected_option_for_moderation_zone_period(moderation_zone)
        ) %>
  </div>

  <div data-expiry-panel="absolute">
    <%= form.datetime_field(
          :ends_at,
          :value => moderation_zone_form_ends_at(moderation_zone),
          :min => moderation_zone_ends_at_min(moderation_zone),
          :max => moderation_zone_ends_at_max
        ) %>
  </div>

  <%= form.primary %>
<% end %>
