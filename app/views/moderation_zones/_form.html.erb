<%# locals: (moderation_zone:) %>

<% content_for :head do %>
  <%= javascript_include_tag "moderation_zone" %>
<% end %>

<%= bootstrap_form_with(:model => moderation_zone) do |form| %>
  <%= form.text_field :name %>

  <%= form.richtext_field :reason, :cols => 80, :rows => 20, :format => moderation_zone.reason_format %>

  <%= form.form_group do %>
    <%= form.label :zone %>
    <div id="map" class="content_map border rounded z-0"></div>
    <%= form.hidden_field :zone %>
  <% end %>

  <% expiry_type = selected_moderation_zone_expiry_type(moderation_zone) %>
  <fieldset class="mb-3">
    <legend class="col-form-label"><%= t ".expiration" %></legend>
    <%= form.radio_button :expiry_type, "relative", :label => t(".relative_expiration"), :checked => expiry_type == "relative" %>
    <%= form.radio_button :expiry_type, "absolute", :label => t(".absolute_expiration"), :checked => expiry_type == "absolute" %>
  </fieldset>

  <div data-expiry-panel="relative">
    <%= form.select(
          :period,
          options_for_moderation_zone_period,
          :selected => selected_option_for_moderation_zone_period(moderation_zone)
        ) %>
  </div>

  <div data-expiry-panel="absolute">
    <%= form.datetime_select(
          :ends_at,
          :include_seconds => true,
          :start_year => [moderation_zone.ends_at&.year || Time.current.year, Time.current.year - 10].min,
          :end_year => [moderation_zone.ends_at&.year || Time.current.year, Time.current.year + 10].max
        ) %>
  </div>

  <%= form.primary %>
<% end %>
