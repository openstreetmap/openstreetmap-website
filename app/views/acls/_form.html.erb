<%# locals: (acl:) %>

<%= bootstrap_form_with(:model => acl) do |form| %>
  <%= form.text_field :address, :value => acl.address_before_type_cast %>
  <%= form.text_field :domain %>
  <%= form.text_field :mx %>
  <%= form.text_field :k %>
  <%= form.text_field :v %>
  <%= form.primary %>
  <%= link_to t(".cancel"), acls_path, :class => "btn btn-link" %>
<% end %>
