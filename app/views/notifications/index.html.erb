<% content_for :head do %>
  <%= javascript_include_tag "notifications" %>
<% end %>

<% content_for :heading do %>
  <h1><%= t ".title" %></h1>
  <p class="mb-0">
    <%= t(
          ".point_to_preferences_html",
          :link => link_to(t(".link_text"), notification_preferences_path)
        ) %>
  </p>
<% end %>

<% if @notifications.items.empty? %>
  <p><%= t(".no_notifications") %></p>
<% else %>
  <div class="row border-bottom pb-2">
    <div class="col-1 text-center">
      <%= check_box_tag "select_page", :class => "align-bottom form-check-input" %>
      <%= tag.label "Select all notifications in this page", :for => "select_page", :class => "visually-hidden" %>
    </div>
    <div class="col-11">
      <%= button_tag t(".mark_selected_read"), :class => "btn btn-primary mb-1", :form => :notifications_form %>
      <%= button_tag t(".mark_selected_unread"), :class => "btn btn-secondary mb-1", :form => :notifications_form, :name => :_method, :value => "delete" %>
    </div>
  </div>
  <%= form_with :url => notifications_reads_path, :id => :notifications_form do |form| %>
    <%= render "page", :notifications => @notifications, :params => @params %>
  <% end %>
<% end %>
