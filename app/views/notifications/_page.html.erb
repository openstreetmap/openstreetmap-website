<%# locals: (notifications:, params:) %>

<turbo-frame id="pagination" target="_top" data-turbo="false">
  <% notifications.items.each do |notification| %>
    <%= render(
          partial_path_for_notification(notification),
          :notification => UserNotifications::Notification.from(notification),
          :record => notification.record
        ) %>
    <hr>
  <% end %>

  <%= render "pagination", :paginator => notifications, :params => params %>
</turbo-frame>
