<%# locals: (title:, uri: nil, timestamp:, missing_record: false) %>

<header class="<%= class_names("row", "align-items-center", "text-secondary" => missing_record) %>">
  <h2 class="col-8 h6"><%= link_to_if(uri, title, uri) %></h2>
  <p class="col-4 text-end"><%= friendly_date_ago(timestamp) %></p>
</header>
